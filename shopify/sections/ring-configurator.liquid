{%- comment -%}
  1999 · Ring Configurator section
  ---------------------------------------------------------------
  Configurador de anel: FORMATO (ícones) + QUILATES (slider) + METAL (swatches).
  Mapeia diretamente às 3 opções de variante do produto no Shopify.

  SETUP (uma vez, no admin do produto):
    1. Crie o produto com EXATAMENTE estas 3 opções (nomes livres, detectados por palavra-chave):
         Opção 1  →  "Formato"  (ou "Shape")      valores: Redondo, Oval, Esmeralda, Almofada, Radiante, Gota, Marquise, Princesa, Asscher...
         Opção 2  →  "Quilates" (ou "Carat")      valores: 0,5 · 0,75 · 1 · 1,5 · 2   (na ordem crescente)
         Opção 3  →  "Metal"    (ou "Material")   valores: Ouro Branco, Ouro Amarelo, Ouro Rosé, Platina, Prata...
    2. Preencha PREÇO por variante e, se quiser, uma IMAGEM por variante (o metal troca a foto).
    3. Adicione esta section ao template do produto (Online Store → Themes → Customize → template "Produto" → Add section)
       ou inclua {% render 'ring-configurator' %} não — é section, use no template product.<nome>.json.
  As outras opções da referência (Style, Natural/Lab Grown) foram propositalmente omitidas.
{%- endcomment -%}

{%- assign v0 = product.selected_or_first_available_variant -%}

<section class="rc" data-rc
  data-accent="{{ section.settings.accent | default: '#1f4a45' }}"
  style="--rc-accent:{{ section.settings.accent | default: '#1f4a45' }};--rc-gold:{{ section.settings.gold | default: '#b8a88a' }};">

  <div class="rc__grid">
    {%- comment -%} ---------- MEDIA ---------- {%- endcomment -%}
    <div class="rc__media">
      <div class="rc__main">
        <img data-rc-main
             src="{% if v0.featured_image %}{{ v0.featured_image | image_url: width: 1200 }}{% elsif product.featured_image %}{{ product.featured_image | image_url: width: 1200 }}{% endif %}"
             alt="{{ product.title | escape }}" width="1200" height="1200" loading="eager">
        {%- if section.settings.shown_note != blank -%}<span class="rc__shown" data-rc-note>{{ section.settings.shown_note }}</span>{%- endif -%}
      </div>
      {%- if product.images.size > 1 -%}
        <div class="rc__thumbs">
          {%- for image in product.images limit: 5 -%}
            <button type="button" class="rc__thumb{% if forloop.first %} is-sel{% endif %}" data-rc-thumb>
              <img src="{{ image | image_url: width: 300 }}" alt="" width="300" height="300" loading="lazy">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ---------- PANEL ---------- {%- endcomment -%}
    <div class="rc__panel">
      <h1 class="rc__title">{{ product.title }}</h1>
      <div class="rc__priceline">
        <span class="rc__price" data-rc-price>{{ v0.price | money }}</span>
        {%- if section.settings.price_suffix != blank -%}<span class="rc__suffix">{{ section.settings.price_suffix }}</span>{%- endif -%}
      </div>

      {%- for option in product.options_with_values -%}
        {%- assign oname = option.name | downcase -%}
        {%- assign pos = option.position -%}

        {%- if oname contains 'formato' or oname contains 'shape' or oname contains 'forma' -%}
          {%- comment -%} ---- SHAPE ---- {%- endcomment -%}
          <div class="rc__group" data-rc-group="{{ pos }}" data-rc-kind="shape">
            <div class="rc__glabel">Formato do diamante: <b data-rc-cur>{{ option.selected_value }}</b></div>
            <div class="rc__shapes">
              {%- for val in option.values -%}
                <button type="button" class="rc__shape{% if val == option.selected_value %} is-sel{% endif %}"
                        data-rc-opt="{{ pos }}" data-rc-val="{{ val | escape }}" aria-label="{{ val | escape }}" title="{{ val | escape }}"></button>
              {%- endfor -%}
            </div>
          </div>

        {%- elsif oname contains 'quilate' or oname contains 'carat' or oname contains 'ct' -%}
          {%- comment -%} ---- CARAT (slider) ---- {%- endcomment -%}
          <div class="rc__group" data-rc-group="{{ pos }}" data-rc-kind="carat">
            <div class="rc__glabel">Quilates: <b data-rc-cur>{{ option.selected_value }}</b></div>
            <div class="rc__slider">
              <span class="rc__send rc__send--min">{{ option.values.first }}</span>
              <input type="range" min="0" max="{{ option.values.size | minus: 1 }}" step="1" value="0"
                     data-rc-opt="{{ pos }}" data-rc-carat aria-label="Quilates"
                     data-vals="{{ option.values | join: '|' | escape }}">
              <span class="rc__send rc__send--max">{{ option.values.last }}</span>
            </div>
          </div>

        {%- elsif oname contains 'metal' or oname contains 'material' -%}
          {%- comment -%} ---- METAL (swatches) ---- {%- endcomment -%}
          <div class="rc__group" data-rc-group="{{ pos }}" data-rc-kind="metal">
            <div class="rc__glabel">Metal: <b data-rc-cur>{{ option.selected_value }}</b></div>
            <div class="rc__metals">
              {%- for val in option.values -%}
                <button type="button" class="rc__metal{% if val == option.selected_value %} is-sel{% endif %}"
                        data-rc-opt="{{ pos }}" data-rc-val="{{ val | escape }}" aria-label="{{ val | escape }}" title="{{ val | escape }}"></button>
              {%- endfor -%}
            </div>
          </div>

        {%- else -%}
          {%- comment -%} ---- fallback: botões simples ---- {%- endcomment -%}
          <div class="rc__group" data-rc-group="{{ pos }}" data-rc-kind="plain">
            <div class="rc__glabel">{{ option.name }}: <b data-rc-cur>{{ option.selected_value }}</b></div>
            <div class="rc__plain">
              {%- for val in option.values -%}
                <button type="button" class="rc__pbtn{% if val == option.selected_value %} is-sel{% endif %}"
                        data-rc-opt="{{ pos }}" data-rc-val="{{ val | escape }}">{{ val }}</button>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <form method="post" action="{{ routes.cart_add_url }}" data-rc-form class="rc__form">
        <input type="hidden" name="id" value="{{ v0.id }}" data-rc-id>
        <button type="submit" class="rc__cta" data-rc-submit>{{ section.settings.cta_text | default: 'Escolher este modelo' }}</button>
        <p class="rc__soldout" data-rc-soldout hidden>Combinação indisponível</p>
      </form>
    </div>
  </div>

  {%- comment -%} data para o JS {%- endcomment -%}
  <script type="application/json" data-rc-variants>
    [{%- for v in product.variants -%}
      {"id":{{ v.id }},"opts":{{ v.options | json }},"available":{{ v.available }},"price":{{ v.price }},"img":{% if v.featured_image %}{{ v.featured_image | image_url: width: 1200 | json }}{% else %}null{% endif %}}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}]
  </script>
  <script type="application/json" data-rc-prices>
    { {%- for v in product.variants -%}"{{ v.id }}":{{ v.price | money | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%} }
  </script>
</section>

{%- comment -%} ---------- SVG sprite (formas) ---------- {%- endcomment -%}
<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
  <symbol id="rcs-round" viewBox="0 0 48 48"><g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"><circle cx="24" cy="24" r="16"/><polygon points="24,12 34,18 34,30 24,36 14,30 14,18"/><path d="M24 8v4M38 16l-4 2M38 32l-4-2M24 40v-4M10 32l4-2M10 16l4 2"/></g></symbol>
